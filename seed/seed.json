{
  "version": "1",
  "defaultLocale": "en",
  "meta": {
    "name": "研之有物",
    "description": "从 Markdown / MDX 博客迁移到 EmDash",
    "author": "刘浪"
  },
  "settings": {
    "title": "研之有物",
    "tagline": "前端技术博客",
    "timezone": "Asia/Shanghai"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "文章",
      "labelSingular": "文章",
      "urlPattern": "/posts/{slug}",
      "supports": ["drafts", "revisions", "preview", "scheduling", "seo"],
      "titleField": "title",
      "fields": [
        {
          "slug": "title",
          "label": "标题",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "description",
          "label": "摘要",
          "type": "text",
          "required": true,
          "searchable": true
        },
        {
          "slug": "cover",
          "label": "封面",
          "type": "image"
        },
        {
          "slug": "content",
          "label": "正文",
          "type": "portableText",
          "required": true,
          "searchable": true
        }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "category",
      "label": "分类",
      "labelSingular": "分类",
      "hierarchical": true,
      "collections": ["posts"],
      "terms": [
        {
          "slug": "css",
          "label": "CSS"
        },
        {
          "slug": "vue",
          "label": "Vue"
        },
        {
          "slug": "react",
          "label": "React"
        },
        {
          "slug": "others",
          "label": "其他"
        },
        {
          "slug": "html",
          "label": "HTML"
        },
        {
          "slug": "javascript",
          "label": "JavaScript"
        },
        {
          "slug": "typescript",
          "label": "TypeScript"
        }
      ]
    },
    {
      "name": "tag",
      "label": "标签",
      "labelSingular": "标签",
      "hierarchical": false,
      "collections": ["posts"]
    }
  ]
}
