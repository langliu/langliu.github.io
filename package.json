{
  "name": "langliu.github.io",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "start": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome check . --write --linter-enabled=false --assist-enabled=false",
    "format:check": "biome check . --linter-enabled=false --assist-enabled=false",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare astro build",
    "deploy": "pnpm run build:cloudflare && wrangler deploy",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@emdash-cms/cloudflare": "1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-seo": "^1.2.0",
    "emdash": "1.2.0",
    "github-slugger": "^2.0.0",
    "kysely": "^0.29.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
