{
  "name": "langliu.github.io",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome check . --write --linter-enabled=false --assist-enabled=false",
    "format:check": "biome check . --linter-enabled=false --assist-enabled=false",
    "content:lint": "node scripts/content-lint.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "pagefind": "pagefind --site dist"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "lefthook": "^2.2.1",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "packageManager": "pnpm@12.11.2"
}
