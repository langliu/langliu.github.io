{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "langliu-blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "langliu-blog",
      "database_id": "0c313563-02e8-4a84-8335-8fd6e28ac38e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "langliu-blog-media"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "account_id": "c50226f9c0209f536f431996c521f7c9",
  "routes": [
    {
      "pattern": "blog.langliu.top",
      "custom_domain": true
    }
  ],
  "vars": {
    "SITE_URL": "https://blog.langliu.top",
    "EMDASH_SITE_URL": "https://blog.langliu.top"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b8ba4b25a7954ea7a6a04709203807e8"
    }
  ]
}
