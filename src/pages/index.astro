---
import { Image } from 'astro:assets'

import Layout from '@/layouts/Layout.astro'
import SocialLinks from '@/components/SocialLinks.astro'
import PostCard from '@/components/PostCard.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Link from '@/components/shared/Link.astro'
import convertAsteriskToStrongTag from '@/utils/convertAsteriskToStrongTag'
import { getPostSlug, getPublishedPosts } from '@/utils/posts'

import presentation from '@/data/presentation'
import projects from '@/data/projects'

const posts = await getPublishedPosts()
---

<Layout>
  <main class="flex flex-col gap-4 md:gap-12">
    <article
      class="flex flex-col gap-8 md:flex-row-reverse md:justify-end md:gap-12"
    >
      {
        presentation.profile && (
          <Image
            src={presentation.profile}
            class="w-1/4 self-center rounded-full"
            alt="刘浪的个人头像"
            width="200"
            height="200"
          />
        )
      }

      <div class="flex flex-col gap-8">
        <h1
          class="w-max bg-linear-to-r from-orange-400 to-purple-500 bg-clip-text text-4xl font-bold text-transparent"
        >
          {presentation.title}
        </h1>

        <h2
          class="w-auto leading-6"
          set:html={convertAsteriskToStrongTag(presentation.description)}
        />
      </div>
    </article>

    <article class="flex flex-col gap-8">
      <header class="flex w-full flex-row justify-between gap-2">
        <h3 class="text-lg text-neutral-100">最新文章</h3>
        <Link href="/posts" label="查看所有" isUnderline target="_self" />
      </header>
      {
        posts.length === 0 && (
          <p class="text-neutral-400">暂无文章，稍后再来看看。</p>
        )
      }

      <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          posts.length !== 0 &&
            posts
              .slice(0, 2)
              .map((post) => (
                <PostCard
                  publishedAt={post.data.publishedAt}
                  title={post.data.title}
                  description={post.data.description}
                  slug={getPostSlug(post)}
                />
              ))
        }
      </section>
    </article>

    <article class="flex flex-col gap-8">
      <header class="flex w-full flex-row justify-between gap-2">
        <h3 class="text-lg text-neutral-100">
          我的项目 ({projects.length})
        </h3>
      </header>
      {
        projects.length === 0 && (
          <p class="text-neutral-400">项目筹备中，敬请期待。</p>
        )
      }
      <section class="grid md:grid-cols-2 gap-4">
        {
          projects.length !== 0 &&
            projects.map((project) => <ProjectCard {...project} />)
        }
      </section>
    </article>

    <article class="flex flex-col gap-8">
      <header class="flex w-full flex-row justify-between gap-2">
        <h3 class="text-lg text-neutral-100">联系我</h3>
      </header>
      <p>
        给我发电子邮件 <Link
          href={`mailto:${presentation.mail}`}
          label={presentation.mail}
        /> 或者通过我的社交链接关注我。
      </p>

      <SocialLinks />
    </article>
  </main>
</Layout>
