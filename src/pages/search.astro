---
import PostListItem from '@/components/PostListItem.astro'
import Layout from '@/layouts/Layout.astro'
import { getCategoryByFilter } from '@/utils/categories'
import {
  getPostTags,
  getPublishedPosts,
  getSortedCategoryStats,
  getSortedTagStats,
} from '@/utils/posts'

const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 200)
const categoryFilter = Astro.url.searchParams.get('category') ?? ''
const tag = Astro.url.searchParams.get('tag') ?? ''
const posts = await getPublishedPosts()
const categories = getSortedCategoryStats(posts).map(([category]) => category)
const category = getCategoryByFilter(categoryFilter, categories)
const tags = getSortedTagStats(posts)
const hasSearch = Boolean(query || categoryFilter || tag)
const words = query.toLocaleLowerCase('zh-CN').split(/\s+/).filter(Boolean)
const matches = hasSearch
  ? posts.filter((post) => {
      const text = [post.data.title, post.data.description, post.body, ...getPostTags(post)]
        .join(' ')
        .toLocaleLowerCase('zh-CN')
      return (
        words.every((word) => text.includes(word)) &&
        (!categoryFilter || post.data.category.slug === category?.slug) &&
        (!tag || getPostTags(post).includes(tag))
      )
    })
  : []
---

<Layout title='研之有物 - 搜索' description='搜索博客文章与内容' noindex={true}>
  <main class='flex flex-col gap-8'>
    <div class='flex flex-col gap-3'>
      <h1 class='text-2xl text-neutral-100'>搜索</h1>
      <p class='text-neutral-400'>输入关键词，查找文章标题、摘要与正文，也可以按分类和标签筛选。</p>
    </div>
    <form action='/search' method='get' class='flex flex-col gap-4' role='search'>
      <label for='search-query' class='sr-only'>搜索本站</label>
      <div class='flex gap-3'>
        <input id='search-query' name='q' type='search' value={query} maxlength='200'
          placeholder='搜索文章…' class='min-w-0 flex-1 rounded-md border border-neutral-700 bg-neutral-900 px-4 py-3' />
        <button type='submit' aria-label='搜索文章' class='rounded-md bg-orange-400 px-5 py-3 text-neutral-950'>搜索</button>
      </div>
      <div class='flex flex-wrap gap-3'>
        <label class='flex items-center gap-2'>
          分类
          <select name='category' aria-label='按分类筛选' class='rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2'>
            <option value=''>全部分类</option>
            {categories.map((value) => <option value={value.slug} selected={category?.slug === value.slug}>{value.label}</option>)}
          </select>
        </label>
        <label class='flex items-center gap-2'>
          标签
          <select name='tag' aria-label='按标签筛选' class='rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2'>
            <option value=''>全部标签</option>
            {tags.map(([value]) => <option value={value} selected={tag === value}>{value}</option>)}
          </select>
        </label>
        {hasSearch && <a href='/search' class='self-center text-neutral-400 underline'>清空筛选</a>}
      </div>
    </form>
    {hasSearch && (
      <section aria-label='搜索结果' class='flex flex-col gap-4'>
        <p role='status'>{matches.length ? `找到 ${matches.length} 篇文章` : '没有找到匹配的文章'}</p>
        {matches.map((post) => <PostListItem post={post} />)}
      </section>
    )}
  </main>
</Layout>
