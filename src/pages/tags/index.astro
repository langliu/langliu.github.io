---
import ArrowIcon from '@/components/shared/ArrowIcon.astro'
import Layout from '@/layouts/Layout.astro'
import { getPublishedPosts, getSortedTagStats, getTagPath } from '@/utils/posts'

const posts = await getPublishedPosts()
const tags = getSortedTagStats(posts)
---

<Layout title='研之有物 - 文章标签' description='按标签浏览研之有物的全部文章'>
  <main class='flex flex-col gap-12'>
    <div class='flex flex-col gap-4'>
      <h1 class='text-2xl text-neutral-100'>文章标签</h1>
      <p class='text-neutral-400'>共 {tags.length} 个标签，{posts.length} 篇文章</p>
    </div>

    {
      tags.length === 0 ? (
        <p class='text-neutral-400'>暂无标签。</p>
      ) : (
        <article class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
          {tags.map(([tag, count]) => (
            <a
              href={getTagPath(tag)}
              class='group flex flex-col gap-2 rounded-md border border-neutral-700 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-neutral-400'
              aria-label={`查看标签 ${tag} 的 ${count} 篇文章`}
            >
              <div class='flex items-center justify-between gap-3'>
                <h2 class='text-lg text-neutral-100 group-hover:text-white'>{tag}</h2>
                <span class='rounded-full bg-neutral-800 px-3 py-1 text-sm text-neutral-400'>
                  {count} 篇
                </span>
              </div>
              <div class='flex items-center gap-2 text-sm text-neutral-500'>
                <span>查看文章</span>
                <ArrowIcon size={16} />
              </div>
            </a>
          ))}
        </article>
      )
    }
  </main>
</Layout>
