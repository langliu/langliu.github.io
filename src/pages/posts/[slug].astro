---
import { type CollectionEntry, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import Toc from '@/components/Toc.astro'
import { SITE_URL } from '@/data/config'
import presentation from '@/data/presentation'
import '@/styles/post.css'
import formatDate from '@/utils/formatDate'
import getReadingTimeMinutes from '@/utils/readingTime'
import {
  getAdjacentPosts,
  getPostPath,
  getPostSlug,
  getPostTags,
  getPostUpdatedAt,
  getPublishedPosts,
  getTagPath,
} from '@/utils/posts'

export async function getStaticPaths() {
  const publishedPosts = await getPublishedPosts()

  return publishedPosts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post, posts: publishedPosts },
  }))
}

type Props = {
  post: CollectionEntry<'posts'>
  posts: CollectionEntry<'posts'>[]
}

const { post, posts } = Astro.props as Props
const { Content, headings } = await render(post)

// 只显示前3级目录
const renderHeadings = headings.filter((header) => header.depth <= 3)
const tags = getPostTags(post)
const postPath = getPostPath(post)
const postUrl = new URL(postPath, SITE_URL).toString()
const publishedAtDate = post.data.publishedAt
const updatedAtDate = getPostUpdatedAt(post)
const publishedAt = publishedAtDate.toISOString()
const updatedAt = updatedAtDate.toISOString()
const showUpdatedAt = updatedAtDate.getTime() !== publishedAtDate.getTime()
const readingTimeMinutes = getReadingTimeMinutes(post.body)
const { newer, older } = getAdjacentPosts(posts, post)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedAt,
  dateModified: updatedAt,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  author: {
    '@type': 'Person',
    name: '刘浪',
    email: presentation.mail,
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: '刘浪',
    url: SITE_URL,
  },
  articleSection: post.data.category,
  keywords: tags.length > 0 ? tags.join(', ') : post.data.category,
  inLanguage: 'zh-CN',
  timeRequired: `PT${readingTimeMinutes}M`,
}
---

<Layout
  title={post.data.title}
  description={post.data.description}
  og={{
    title: post.data.title,
    description: post.data.description,
    type: 'article',
  }}
  jsonLd={jsonLd}
>
  <main class='mx-auto flex w-full flex-col gap-6'>
    <div>
      <a
        href='/posts'
        class='inline-flex items-center gap-2 text-sm text-neutral-400 transition-colors hover:text-neutral-100'
      >
        <svg
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <path d='M19 12H5M12 19l-7-7 7-7'></path>
        </svg>
        返回文章列表
      </a>
    </div>

    <header class='flex flex-col gap-4'>
      <h1 class='text-3xl font-bold text-neutral-100 md:text-4xl'>{post.data.title}</h1>

      <div class='flex flex-col gap-3 text-sm text-neutral-400'>
        <div class='flex flex-row flex-wrap items-center gap-x-2 gap-y-2'>
          <span>
            发布于 <time datetime={publishedAt}>{formatDate(publishedAtDate)}</time>
          </span>
          {
            showUpdatedAt && (
              <>
                <span class='text-neutral-600' aria-hidden='true'>
                  ·
                </span>
                <span>
                  更新于 <time datetime={updatedAt}>{formatDate(updatedAtDate)}</time>
                </span>
              </>
            )
          }
          <span class='text-neutral-600' aria-hidden='true'>
            ·
          </span>
          <span>{`约 ${readingTimeMinutes} 分钟阅读`}</span>
          <span class='text-neutral-600' aria-hidden='true'>
            ·
          </span>
          <a
            href={`/categories/${post.data.category}`}
            class='inline-flex items-center rounded-full border border-neutral-700 px-2.5 py-0.5 text-neutral-300 no-underline transition-colors hover:border-neutral-400 hover:text-neutral-100'
          >
            {post.data.category}
          </a>
        </div>

        {
          tags.length > 0 && (
            <ul class='m-0 flex list-none flex-row flex-wrap items-center gap-2 p-0' aria-label='文章标签'>
              {tags.map((tag) => (
                <li class='m-0 list-none p-0'>
                  <a
                    href={getTagPath(tag)}
                    class='inline-flex items-center rounded-md bg-neutral-800 px-2.5 py-1 text-xs text-neutral-300 no-underline transition-colors hover:bg-neutral-700 hover:text-neutral-100'
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <p class='m-0 text-base leading-7 text-neutral-300 italic'>{post.data.description}</p>
    </header>

    <div class='container'>
      <article class='post flex-1'>
        <Content />
      </article>
      <Toc headings={renderHeadings} />
    </div>

    {
      (newer || older) && (
        <nav
          class='mt-8 grid gap-4 border-t border-neutral-800 pt-8 md:grid-cols-2'
          aria-label='相邻文章'
        >
          {older ? (
            <a
              href={getPostPath(older)}
              class='group flex flex-col gap-2 rounded-md border border-neutral-700 p-4 transition-all hover:border-neutral-400'
            >
              <span class='text-sm text-neutral-500'>上一篇</span>
              <span class='text-neutral-100 group-hover:text-white'>{older.data.title}</span>
            </a>
          ) : (
            <div />
          )}
          {newer ? (
            <a
              href={getPostPath(newer)}
              class='group flex flex-col gap-2 rounded-md border border-neutral-700 p-4 text-right transition-all hover:border-neutral-400 md:items-end'
            >
              <span class='text-sm text-neutral-500'>下一篇</span>
              <span class='text-neutral-100 group-hover:text-white'>{newer.data.title}</span>
            </a>
          ) : (
            <div />
          )}
        </nav>
      )
    }
  </main>
</Layout>

<style>
  .container {
    display: flex;
    gap: 64px;
  }
</style>
