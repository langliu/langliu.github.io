---
import { type CollectionEntry, render } from 'astro:content'
import CodeCopy from '@/components/CodeCopy.astro'
import ReadingProgress from '@/components/ReadingProgress.astro'
import { SITE_URL } from '@/data/config'
import { getCategoryPath } from '@/data/postCategories'
import presentation from '@/data/presentation'
import Layout from '@/layouts/Layout.astro'
import '@/styles/post.css'
import formatDate from '@/utils/formatDate'
import {
  getAdjacentPosts,
  getPostPath,
  getPostSlug,
  getPostTags,
  getPostUpdatedAt,
  getPublishedPosts,
  getRelatedPosts,
  getTagPath,
} from '@/utils/posts'
import getReadingTimeMinutes from '@/utils/readingTime'

export async function getStaticPaths() {
  const publishedPosts = await getPublishedPosts()

  return publishedPosts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post, posts: publishedPosts },
  }))
}

type Props = {
  post: CollectionEntry<'posts'>
  posts: CollectionEntry<'posts'>[]
}

const { post, posts } = Astro.props as Props
const { Content } = await render(post)

const tags = getPostTags(post)
const postPath = getPostPath(post)
const postUrl = new URL(postPath, SITE_URL).toString()
const publishedAtDate = post.data.publishedAt
const updatedAtDate = getPostUpdatedAt(post)
const publishedAt = publishedAtDate.toISOString()
const updatedAt = updatedAtDate.toISOString()
const showUpdatedAt = updatedAtDate.getTime() !== publishedAtDate.getTime()
const readingTimeMinutes = getReadingTimeMinutes(post.body)
const { newer, older } = getAdjacentPosts(posts, post)
const relatedPosts = getRelatedPosts(posts, post, 3)
const cover = post.data.cover
const postImageModules = import.meta.glob<{ default: { src: string } }>(
  '../../assets/posts/*.{webp,png,jpg,jpeg,avif}',
  { eager: true },
)

function resolveCoverUrl(coverValue: string | undefined): string | undefined {
  if (!coverValue) {
    return undefined
  }

  if (coverValue.startsWith('http://') || coverValue.startsWith('https://')) {
    return coverValue
  }

  if (coverValue.startsWith('/')) {
    return new URL(coverValue.slice(1), SITE_URL).toString()
  }

  const fileName = coverValue.split('/').pop()
  if (!fileName) {
    return undefined
  }

  const matched = Object.entries(postImageModules).find(([path]) => path.endsWith(`/${fileName}`))
  if (!matched) {
    return undefined
  }

  const assetSrc = matched[1].default.src
  return new URL(assetSrc.replace(/^\//, ''), SITE_URL).toString()
}

const ogImage = resolveCoverUrl(cover)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedAt,
  dateModified: updatedAt,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  author: {
    '@type': 'Person',
    name: '刘浪',
    email: presentation.mail,
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: '刘浪',
    url: SITE_URL,
  },
  articleSection: post.data.category,
  keywords: tags.length > 0 ? tags.join(', ') : post.data.category,
  inLanguage: 'zh-CN',
  timeRequired: `PT${readingTimeMinutes}M`,
  ...(ogImage ? { image: [ogImage] } : {}),
}
---

<Layout
  title={post.data.title}
  description={post.data.description}
  og={{
    title: post.data.title,
    description: post.data.description,
    type: 'article',
    image: ogImage,
    alt: post.data.title,
  }}
  jsonLd={jsonLd}
>
  <ReadingProgress />
  <main class='mx-auto flex w-full max-w-300 flex-col gap-6'>
    <div>
      <a
        href='/posts'
        class='inline-flex items-center gap-2 text-sm text-neutral-400 transition-colors hover:text-neutral-100'
      >
        <svg
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <path d='M19 12H5M12 19l-7-7 7-7'></path>
        </svg>
        返回文章列表
      </a>
    </div>

    <header class='flex flex-col gap-4'>
      <h1 class='text-3xl font-bold text-neutral-100 md:text-4xl'>{post.data.title}</h1>

      <div class='flex flex-col gap-3 text-sm text-neutral-400'>
        <div class='flex flex-row flex-wrap items-center gap-x-2 gap-y-2'>
          <span>
            发布于 <time datetime={publishedAt}>{formatDate(publishedAtDate)}</time>
          </span>
          {
            showUpdatedAt && (
              <>
                <span class='text-neutral-600' aria-hidden='true'>
                  ·
                </span>
                <span>
                  更新于 <time datetime={updatedAt}>{formatDate(updatedAtDate)}</time>
                </span>
              </>
            )
          }
          <span class='text-neutral-600' aria-hidden='true'>
            ·
          </span>
          <span>{`约 ${readingTimeMinutes} 分钟阅读`}</span>
          <span class='text-neutral-600' aria-hidden='true'>
            ·
          </span>
          <a
            href={getCategoryPath(post.data.category)}
            class='inline-flex items-center rounded-full border border-neutral-700 px-2.5 py-0.5 text-neutral-300 no-underline transition-colors hover:border-neutral-400 hover:text-neutral-100'
          >
            {post.data.category}
          </a>
        </div>

        {
          tags.length > 0 && (
            <ul class='m-0 flex list-none flex-row flex-wrap items-center gap-2 p-0' aria-label='文章标签'>
              {tags.map((tag) => (
                <li class='m-0 list-none p-0'>
                  <a
                    href={getTagPath(tag)}
                    class='inline-flex items-center rounded-md bg-neutral-800 px-2.5 py-1 text-xs text-neutral-300 no-underline transition-colors hover:bg-neutral-700 hover:text-neutral-100'
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <p class='m-0 text-base leading-7 text-neutral-300 italic'>{post.data.description}</p>
    </header>

    <article class='post' data-pagefind-body>
      <Content />
    </article>

    <CodeCopy />

    {
      relatedPosts.length > 0 && (
        <section class='border-t border-neutral-800 pt-8' aria-labelledby='related-posts-title'>
          <h2 id='related-posts-title' class='mb-4 text-lg text-neutral-100'>
            相关文章
          </h2>
          <ul class='grid list-none gap-3 p-0 md:grid-cols-3'>
            {relatedPosts.map((related) => (
              <li class='m-0 p-0'>
                <a
                  href={getPostPath(related)}
                  class='flex h-full flex-col gap-2 rounded-md border border-neutral-700 p-4 transition-colors hover:border-neutral-400'
                >
                  <span class='text-sm text-neutral-500'>{related.data.category}</span>
                  <span class='text-neutral-100'>{related.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (newer || older) && (
        <nav
          class='grid gap-4 border-t border-neutral-800 pt-8 md:grid-cols-2'
          aria-label='相邻文章'
        >
          {older ? (
            <a
              href={getPostPath(older)}
              class='group flex flex-col gap-2 rounded-md border border-neutral-700 p-4 transition-all hover:border-neutral-400'
            >
              <span class='text-sm text-neutral-500'>上一篇</span>
              <span class='text-neutral-100 group-hover:text-white'>{older.data.title}</span>
            </a>
          ) : (
            <div />
          )}
          {newer ? (
            <a
              href={getPostPath(newer)}
              class='group flex flex-col gap-2 rounded-md border border-neutral-700 p-4 text-right transition-all hover:border-neutral-400 md:items-end'
            >
              <span class='text-sm text-neutral-500'>下一篇</span>
              <span class='text-neutral-100 group-hover:text-white'>{newer.data.title}</span>
            </a>
          ) : (
            <div />
          )}
        </nav>
      )
    }
  </main>
</Layout>
