---
import ArrowIcon from '@/components/shared/ArrowIcon.astro'
import formatDate from '@/utils/formatDate'
import { getPostPath, type PostEntry } from '@/utils/posts'
import getReadingTimeMinutes from '@/utils/readingTime'

type Props = {
  post: PostEntry
}

const { post } = Astro.props as Props
const readingTimeMinutes = getReadingTimeMinutes(post.body)
---

<a
  class='group flex flex-col gap-2 border-t border-neutral-700 py-4 transition-all hover:text-neutral-100'
  href={getPostPath(post)}
  aria-label={`阅读文章：${post.data.title}`}
>
  <div class='flex w-full items-start justify-between gap-4'>
    <h2 class='text-lg text-neutral-100'>{post.data.title}</h2>

    <div class='flex shrink-0 flex-row items-center gap-3 text-sm text-neutral-400'>
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <ArrowIcon />
    </div>
  </div>

  <div class='flex flex-row flex-wrap items-center gap-x-2 gap-y-1 text-xs text-neutral-500'>
    <span>{post.data.category}</span>
    <span aria-hidden='true'>·</span>
    <span>{`约 ${readingTimeMinutes} 分钟`}</span>
  </div>

  <p class='text-sm text-neutral-400'>{post.data.description}</p>
</a>
