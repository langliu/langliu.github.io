---
type Props = {
  size?: number
  class?: string
}

const { size = 18, class: className = 'transition-all duration-300 group-hover:translate-x-1' } =
  Astro.props
---

<svg
  width={size}
  height={size}
  viewBox='0 0 18 18'
  fill='none'
  class={className}
  aria-hidden='true'
>
  <path
    d='M5.25 12.75L12.75 5.25'
    stroke='#999999'
    stroke-linecap='round'
    stroke-linejoin='round'></path>
  <path
    d='M5.25 5.25H12.75V12.75'
    stroke='#999999'
    stroke-linecap='round'
    stroke-linejoin='round'></path>
</svg>
