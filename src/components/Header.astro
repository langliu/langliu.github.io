---
import { Image } from 'astro:assets'
import logoMark from '@/assets/brand/logo-mark.png'
import removeTrailingSlash from '@/utils/removeTrailingSlash'

const pathname = removeTrailingSlash(Astro.url.pathname)

const navItems = [
  { href: '/', label: '首页', active: pathname === '/' },
  { href: '/posts', label: '文章', active: pathname === '/posts' },
  {
    href: '/categories',
    label: '分类',
    active: pathname === '/categories' || pathname.startsWith('/categories/'),
  },
  {
    href: '/tags',
    label: '标签',
    active: pathname === '/tags' || pathname.startsWith('/tags/'),
  },
  {
    href: '/search',
    label: '搜索',
    active: pathname === '/search',
  },
] as const
---

<header class='z-40 flex w-full flex-col gap-3 sm:flex-row sm:items-center sm:justify-between'>
  <a
    href='/'
    class='group flex items-center gap-2 text-neutral-300 transition-colors hover:text-neutral-100'
    aria-label='研之有物 首页'
  >
    <Image
      src={logoMark}
      alt=''
      width={28}
      height={28}
      class='h-7 w-7 rounded-md'
      densities={[1, 2]}
      loading='eager'
      fetchpriority='high'
    />
    <span class='text-sm font-medium tracking-wide sm:text-base'>研之有物</span>
  </a>

  <nav aria-label='主导航'>
    <ul role='list' class='flex flex-row flex-wrap items-center gap-x-3 gap-y-2 text-sm sm:text-base'>
      {
        navItems.map((item, index) => (
          <>
            {index > 0 && (
              <li class='text-neutral-600' aria-hidden='true'>
                /
              </li>
            )}
            <li>
              <a
                href={item.href}
                class:list={{
                  'hover:text-neutral-100': true,
                  'text-neutral-100': item.active,
                }}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          </>
        ))
      }
    </ul>
  </nav>
</header>
