---
import presentation from '@/data/presentation'
import removeTrailingSlash from '@/utils/removeTrailingSlash'

const pathname = removeTrailingSlash(Astro.url.pathname)

const navItems = [
  { href: '/', label: '首页', active: pathname === '/' },
  { href: '/posts', label: '文章', active: pathname === '/posts' },
  {
    href: '/categories',
    label: '分类',
    active: pathname === '/categories' || pathname.startsWith('/categories/'),
  },
  {
    href: '/tags',
    label: '标签',
    active: pathname === '/tags' || pathname.startsWith('/tags/'),
  },
  {
    href: '/search',
    label: '搜索',
    active: pathname === '/search',
  },
] as const
---

<header class='z-40 flex w-full flex-col gap-3 sm:flex-row sm:items-center sm:justify-between'>
  <a href={`mailto:${presentation.mail}`} class='hover:text-neutral-100'>{presentation.mail}</a>

  <nav aria-label='主导航'>
    <ul role='list' class='flex flex-row flex-wrap items-center gap-x-3 gap-y-2 text-sm sm:text-base'>
      {
        navItems.map((item, index) => (
          <>
            {index > 0 && (
              <li class='text-neutral-600' aria-hidden='true'>
                /
              </li>
            )}
            <li>
              <a
                href={item.href}
                class:list={{
                  'hover:text-neutral-100': true,
                  'text-neutral-100': item.active,
                }}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          </>
        ))
      }
    </ul>
  </nav>
</header>
