---
type Heading = {
  depth: number
  slug: string
  text: string
}

type Props = {
  headings: Heading[]
}

const { headings } = Astro.props
---

{
  headings.length > 0 && (
    <div class='content-of-tables'>
      <nav class='nav' aria-label='文章目录'>
        <h2 class='toc-title'>目录</h2>
        {headings.map((heading) => (
          <a class:list={['nav-link', `depth-${heading.depth}`]} href={`#${heading.slug}`}>
            {heading.text}
          </a>
        ))}
      </nav>
    </div>
  )
}

<style>
  .content-of-tables {
    grid-column: 3;
    grid-row: 1 / 200;
    align-self: start;
    width: 250px;
    margin-left: auto;
    margin-top: 0.125em;
    flex-shrink: 0;
    line-height: inherit;
    position: sticky;
    top: 8rem;
  }

  .nav {
    transition:
      opacity 0.4s,
      transform 0.7s cubic-bezier(0.17, 0.67, 0.54, 1);
    transform: translateX(0);
  }

  .toc-title {
    font-size: 1rem;
    margin-bottom: 16px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: hsl(210deg 25% 88%);
    line-height: 24px;
  }

  .nav-link {
    display: block;
    opacity: 0.7;
    text-decoration: none;
    transition: opacity 0.5s;
    font-size: 14px;
    line-height: 1.5;
    word-break: break-word;

    &:hover {
      opacity: 1;
      transition: opacity 0ms;
    }
  }

  .depth-2 {
    margin-top: 12px;
    font-size: 16px;
  }

  .depth-3 {
    margin-top: 4px;
    padding-left: 12px;
  }

  .depth-4 {
    margin-top: 4px;
    padding-left: 24px;
  }

  .active {
    opacity: 1;
    color: hsl(225deg 100% 75%);
    font-weight: 500;
  }

  @media screen and (max-width: 1080px) {
    .content-of-tables {
      display: none;
    }
  }
</style>

<script>
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.content-of-tables a[href^="#"]'),
  )
  const tocHeadingIds = new Set(
    tocLinks.map((link) => decodeURIComponent(link.hash.slice(1))).filter(Boolean),
  )
  const headingElements = Array.from(
    document.querySelectorAll<HTMLElement>('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]'),
  ).filter((heading) => tocHeadingIds.has(heading.id))

  function setActiveHeading(activeHeadingId: string | undefined) {
    tocLinks.forEach((link) => {
      const href = link.getAttribute('href')?.slice(1)
      link.classList.toggle('active', href === activeHeadingId)
    })
  }

  function getActiveHeadingId(visibleHeadingIds: Set<string>): string | undefined {
    const firstVisibleHeading = headingElements.find((heading) => visibleHeadingIds.has(heading.id))

    if (firstVisibleHeading) {
      return firstVisibleHeading.id
    }

    let activeHeadingId = headingElements[0]?.id
    for (const heading of headingElements) {
      if (heading.getBoundingClientRect().top <= 120) {
        activeHeadingId = heading.id
        continue
      }
      break
    }

    return activeHeadingId
  }

  function createTocObserver(): () => void {
    const visibleHeadingIds = new Set<string>()

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const headingId = entry.target.id
          if (entry.isIntersecting) {
            visibleHeadingIds.add(headingId)
          } else {
            visibleHeadingIds.delete(headingId)
          }
        })

        setActiveHeading(getActiveHeadingId(visibleHeadingIds))
      },
      {
        rootMargin: '-100px 0px -65% 0px',
        threshold: [0, 1],
      },
    )

    headingElements.forEach((heading) => observer.observe(heading))
    setActiveHeading(getActiveHeadingId(visibleHeadingIds))

    return () => observer.disconnect()
  }

  const desktopMediaQuery = window.matchMedia('(min-width: 1081px)')
  let disconnectObserver: (() => void) | undefined

  function updateTocObserverState() {
    disconnectObserver?.()
    disconnectObserver = undefined

    if (!desktopMediaQuery.matches || tocLinks.length === 0 || headingElements.length === 0) {
      return
    }

    disconnectObserver = createTocObserver()
  }

  updateTocObserverState()

  const handleViewportChange = () => updateTocObserverState()
  desktopMediaQuery.addEventListener('change', handleViewportChange)

  window.addEventListener(
    'pagehide',
    () => {
      disconnectObserver?.()
      desktopMediaQuery.removeEventListener('change', handleViewportChange)
    },
    { once: true },
  )
</script>
