---
import ArrowIcon from '@/components/shared/ArrowIcon.astro'
import type { Project } from '@/data/projects'

type Props = Project

const { title, description, techs, link, isComingSoon } = Astro.props

const formatTechs = (values: string[]) => values.join(' • ')
---

{
  isComingSoon ? (
    <div class='flex w-full flex-col gap-2 rounded-md border border-neutral-700 p-4'>
      <div class='flex flex-col gap-2 md:flex-row md:items-center md:justify-between'>
        <p class='text-neutral-100'>{title}</p>
        <p class='w-fit rounded-md bg-neutral-900 px-4 py-1 text-sm'>Soon</p>
      </div>
      <p class='text-sm text-neutral-400'>{description}</p>
      <p class='text-xs text-neutral-500'>{formatTechs(techs)}</p>
    </div>
  ) : (
    <a
      class='group flex w-full cursor-pointer flex-col gap-2 rounded-md border border-neutral-700 p-4 transition-all duration-300 hover:-translate-y-2 hover:border-neutral-400'
      href={link}
      target='_blank'
      rel='noreferrer'
      aria-label={`查看项目 ${title}`}
    >
      <div class='flex items-start justify-between gap-3'>
        <p class='text-neutral-100'>{title}</p>
        <ArrowIcon />
      </div>
      <p class='text-sm text-neutral-400'>{description}</p>
      <p class='text-xs text-neutral-500'>{formatTechs(techs)}</p>
    </a>
  )
}
