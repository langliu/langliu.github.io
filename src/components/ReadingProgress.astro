---

<div
  class='reading-progress pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 bg-transparent'
  aria-hidden='true'
>
  <div class='reading-progress__bar h-full w-0 bg-linear-to-r from-orange-400 to-purple-500'></div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('.reading-progress__bar')
  const article = document.querySelector<HTMLElement>('article.post')

  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect()
      const articleTop = window.scrollY + rect.top
      const articleHeight = article.offsetHeight
      const viewport = window.innerHeight
      const readable = Math.max(articleHeight - viewport, 1)
      const progressed = Math.min(Math.max(window.scrollY - articleTop, 0), readable)
      const ratio = progressed / readable
      bar.style.width = `${(ratio * 100).toFixed(2)}%`
    }

    update()
    window.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
  }
</script>
