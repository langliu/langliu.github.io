{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext"
  },
  "include": [".astro/types.d.ts", "astro.config.mjs", "src/**/*", "worker-configuration.d.ts"],
  "exclude": ["dist", ".worktrees", "worktrees", "public", "node_modules"]
}
